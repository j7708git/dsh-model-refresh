{
  "name": "dsh-model-refresh",
  "version": "0.2.3",
  "description": "DSH llm-pi-ai 模型清單智慧更新工具（Nous Portal + OpenRouter）— core + CLI + 常駐 plugin",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "bin": {
    "model-refresh": "src/cli/main.js"
  },
  "main": "./src/plugin/index.js",
  "exports": {
    ".": "./src/plugin/index.js",
    "./plugin": "./src/plugin/index.js",
    "./plugin/loop": "./src/plugin/loop.js",
    "./core": "./src/core/planner.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "fixtures": "node scripts/refresh-fixtures.mjs",
    "plan": "node src/cli/main.js plan",
    "apply": "node src/cli/main.js apply",
    "status": "node src/cli/main.js status",
    "verify:real-host": "node scripts/verify-cordis-mount.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-settings": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "dependencies": {
    "schemastery": "^3.18.0",
    "yaml": "^2.7.0"
  },
  "files": [
    "src",
    "config",
    "cordis.patch.yml",
    "README.md",
    "開發文件.md"
  ]
}
